---
import type { MarkdownHeading } from 'astro'

interface Props {
  title: string
  headings: MarkdownHeading[]
}

const { title, headings } = Astro.props
---

<nav class="sticky top-20 w-72 px-2 py-4 font-sans">
  <ul class="text-sm list-disc list-inside">
    <li>
      <span class="link link-hover" onclick="window.scrollTo({'top': 0, behavior: 'smooth'})">{title}</span>
    </li>
    {
      headings
        .filter((h) => !(h.depth > 3))
        .map((heading) => (
          <li class={['ms-4', 'ms-8'][heading.depth - 2]}>
            <a href={`#${heading.slug}`} class="link link-hover">
              <span>{heading.text}</span>
            </a>
          </li>
        ))
    }
  </ul>
</nav>
