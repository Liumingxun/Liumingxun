---
import DefaultLayout from '@/layouts/default.astro'
import { collectTags, getAllNotes } from '@/utils/notes'

const tags = collectTags(await getAllNotes())
---

<DefaultLayout
  seo={{
    title: 'Tags',
    description: '按标签浏览站内的笔记与文章',
  }}
>
  <div class="m-6">
    {
      tags.length === 0 ? (
        <p class="opacity-60">还没有任何标签。</p>
      ) : (
        <div class="flex flex-wrap gap-3">
          {tags.map(({ tag, slug, notes }) => (
            <a class="badge badge-lg badge-outline gap-2" href={`/tags/${slug}`}>
              <span>{tag}</span>
              <span class="opacity-60">{notes.length}</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</DefaultLayout>
